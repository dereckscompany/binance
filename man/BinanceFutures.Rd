\section{Order Types}{

\itemize{
\item \code{"LIMIT"}: requires \code{price}, \code{quantity}, \code{timeInForce}.
\item \code{"MARKET"}: requires \code{quantity}.
\item \code{"STOP"}, \code{"STOP_MARKET"}: conditional stop orders.
\item \code{"TAKE_PROFIT"}, \code{"TAKE_PROFIT_MARKET"}: conditional take-profit orders.
\item \code{"TRAILING_STOP_MARKET"}: trailing stop order.
}
}

\section{Position Sides}{

\itemize{
\item \code{"BOTH"}: One-way mode (default).
\item \code{"LONG"}, \code{"SHORT"}: Hedge mode.
}
}

