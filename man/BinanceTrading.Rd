\section{Order Types}{

\itemize{
\item \code{"LIMIT"}: requires \code{price}, \code{quantity}, \code{timeInForce}.
\item \code{"MARKET"}: requires either \code{quantity} or \code{quoteOrderQty}.
\item \code{"STOP_LOSS"}, \code{"STOP_LOSS_LIMIT"}, \code{"TAKE_PROFIT"}, \code{"TAKE_PROFIT_LIMIT"}: conditional.
\item \code{"LIMIT_MAKER"}: like LIMIT but rejected if it would immediately match.
}
}

\section{Time-In-Force Options}{

\itemize{
\item \code{"GTC"} (Good Till Cancelled): Remains until filled or cancelled. Default.
\item \code{"IOC"} (Immediate Or Cancel): Fill immediately or cancel remainder.
\item \code{"FOK"} (Fill Or Kill): Fill entirely or cancel completely.
}
}

\section{Self-Trade Prevention}{

\itemize{
\item \code{"NONE"}, \code{"EXPIRE_TAKER"}, \code{"EXPIRE_MAKER"}, \code{"EXPIRE_BOTH"}.
}
