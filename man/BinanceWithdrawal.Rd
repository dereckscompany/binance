\subsection{Method \code{add_withdrawal()}}{
Submit Withdrawal

Initiates a withdrawal request. The API key must have Withdrawal permission
enabled. Returns a withdrawal ID on success.
\subsection{API Endpoint}{

\verb{POST https://api.binance.com/sapi/v1/capital/withdraw/apply}
}

\subsection{Official Documentation}{

\href{https://developers.binance.com/docs/wallet/capital/withdraw}{Binance Withdraw}
Verified: 2026-05-22
}

\subsection{Automated Trading Usage}{
\itemize{
\item \strong{Profit Extraction}: Withdraw profits to a cold wallet at regular intervals.
\item \strong{Multi-Network Support}: Specify \code{network} (e.g., \code{"ETH"}, \code{"TRX"}, \code{"BSC"})
to select the cheapest or fastest network.
\item \strong{Wallet Selection}: Use \code{walletType} to withdraw from spot (0) or funding (1) wallet.
}
}

