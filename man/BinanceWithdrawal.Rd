\subsection{Method \code{get_withdrawal_history()}}{
Get Withdrawal History

Retrieves withdrawal transaction history with optional filtering by coin,
status, and time range. Max time range is 90 days.
\subsection{API Endpoint}{

\verb{GET https://api.binance.com/sapi/v1/capital/withdraw/history}
}

\subsection{Official Documentation}{

\href{https://developers.binance.com/docs/wallet/capital/withdraw-history}{Binance Withdraw History}
Verified: 2026-05-22
}

\subsection{Automated Trading Usage}{
\itemize{
\item \strong{Withdrawal Monitoring}: Poll for status \code{6} (completed) to confirm funds have
left the exchange.
\item \strong{Reconciliation}: Match \code{tx_id} against on-chain transaction hashes for audit.
\item \strong{Failure Diagnosis}: Check \code{info} field for error details on failed withdrawals.
}
}

