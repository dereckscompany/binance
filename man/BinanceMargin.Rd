\subsection{Method \code{get_force_liquidation_history()}}{
Get Force Liquidation History

Retrieves margin force liquidation records with pagination.
\subsection{API Endpoint}{

\verb{GET https://api.binance.com/sapi/v1/margin/forceLiquidationRec}
}

\subsection{Official Documentation}{

\href{https://developers.binance.com/docs/margin_trading/trade/Get-Force-Liquidation-Record}{Binance Force Liquidation}

Verified: 2026-05-22
}

\subsection{curl}{

\if{html}{\out{<div class="sourceCode">}}\preformatted{curl -X GET 'https://api.binance.com/sapi/v1/margin/forceLiquidationRec?current=1&size=10&timestamp=...&signature=...' \\
  -H 'X-MBX-APIKEY: your-api-key'
}\if{html}{\out{</div>}}
}

\subsection{JSON Response}{

\if{html}{\out{<div class="sourceCode json">}}\preformatted{\{
  "rows": [
    \{
      "avgPrice": "52341.12000000",
      "executedQty": "0.00100000",
      "orderId": 12345678,
      "price": "52000.00000000",
      "qty": "0.00100000",
      "side": "SELL",
      "symbol": "BTCUSDT",
      "timeInForce": "GTC",
      "isIsolated": false,
      "updatedTime": 1672099200000,
      "time": 1672099100000
    \}
  ],
  "total": 1
\}
}\if{html}{\out{</div>}}
}
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{BinanceMargin$get_force_liquidation_history(
  start_time = NULL,
  end_time = NULL,
  isolated_symbol = NULL,
  current = NULL,
  size = NULL,
  recv_window = NULL
)}\if{html}{\out{</div>}}
}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{start_time}}{(scalar<count>?) start timestamp in milliseconds.}

\item{\code{end_time}}{(scalar<count>?) end timestamp in milliseconds.}

\item{\code{isolated_symbol}}{(scalar<character>?) isolated margin pair.}

\item{\code{current}}{(scalar<count>?) current page (default 1).}

\item{\code{size}}{(scalar<count>?) page size (default 10, max 100).}

\item{\code{recv_window}}{(scalar<count>?) max 60000.}
}
\if{html}{\out{</div>}}
}
\subsection{Returns}{
(data.table | promise<data.table>) one row per liquidation record
(empty when there are none):
\itemize{
\item avg_price (character) Average liquidation price.
\item executed_qty (character) Liquidated quantity.
\item order_id (numeric) Liquidation order identifier.
\item price (character) Liquidation price.
\item qty (character) Total quantity.
\item side (character) \code{"BUY"} or \code{"SELL"}.
\item symbol (character) Trading pair.
\item time (POSIXct) Liquidation time.
\item is_isolated (logical) Whether this was an isolated margin liquidation.
\item updated_time (POSIXct) Last update time.
}
}
\subsection{Examples}{
\if{html}{\out{<div class="r example copy">}}
\preformatted{\dontrun{
