\subsection{Method \code{add_isolated_transfer()}}{
Isolated Margin Transfer

Transfers assets between spot and isolated margin accounts.
\subsection{API Endpoint}{

\verb{POST https://api.binance.com/sapi/v1/margin/isolated/transfer}
}

\subsection{Official Documentation}{

\href{https://developers.binance.com/docs/wallet/asset/user-universal-transfer}{Binance Universal Transfer}
(Binance retired the dedicated isolated-margin-transfer doc
page; the universal-transfer endpoint subsumes it. The
\code{sapi/v1/margin/isolated/transfer} REST endpoint this wrapper
calls still works at the time of writing.)

Verified: 2026-05-22
}

\subsection{curl}{

\if{html}{\out{<div class="sourceCode">}}\preformatted{curl -X POST 'https://api.binance.com/sapi/v1/margin/isolated/transfer?asset=USDT&symbol=BTCUSDT&transFrom=SPOT&transTo=ISOLATED_MARGIN&amount=100&timestamp=...&signature=...' \\
  -H 'X-MBX-APIKEY: your-api-key'
}\if{html}{\out{</div>}}
}

\subsection{JSON Request}{

\if{html}{\out{<div class="sourceCode json">}}\preformatted{\{
  "asset": "USDT",
  "symbol": "BTCUSDT",
  "transFrom": "SPOT",
  "transTo": "ISOLATED_MARGIN",
  "amount": "100"
\}
}\if{html}{\out{</div>}}
}

\subsection{JSON Response}{

\if{html}{\out{<div class="sourceCode json">}}\preformatted{\{
  "tranId": 100000003
\}
}\if{html}{\out{</div>}}
}
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{BinanceMargin$add_isolated_transfer(
  asset,
  symbol,
  transFrom,
  transTo,
  amount,
  recvWindow = NULL
)}\if{html}{\out{</div>}}
}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{asset}}{Character; asset to transfer (e.g., \code{"USDT"}).}

\item{\code{symbol}}{Character; isolated margin pair (e.g., \code{"BTCUSDT"}).}

\item{\code{transFrom}}{Character; source account: \code{"SPOT"} or \code{"ISOLATED_MARGIN"}.}

\item{\code{transTo}}{Character; destination account: \code{"SPOT"} or \code{"ISOLATED_MARGIN"}.}

\item{\code{amount}}{Numeric; amount to transfer.}

\item{\code{recvWindow}}{Integer or NULL; max 60000.}
}
\if{html}{\out{</div>}}
}
\subsection{Returns}{
\code{data.table} with one row and the following columns:
\itemize{
\item \code{tran_id} (integer): Transaction identifier.
}
}
\subsection{Examples}{
\if{html}{\out{<div class="r example copy">}}
\preformatted{\dontrun{
margin <- BinanceMargin$new()
result <- margin$add_isolated_transfer(
  asset = "USDT", symbol = "BTCUSDT",
  transFrom = "SPOT", transTo = "ISOLATED_MARGIN",
  amount = 100
)
print(result)
}
}
\if{html}{\out{</div>}}

}

}
