\subsection{Method \code{get_trades()}}{
Get Margin Trades

Retrieves margin trade history for a symbol.
\subsection{API Endpoint}{

\verb{GET https://api.binance.com/sapi/v1/margin/myTrades}
}

\subsection{Official Documentation}{

\href{https://developers.binance.com/docs/margin_trading/trade/Query-Margin-Account-Trade-List}{Binance Margin Trades}

Verified: 2026-05-22
}

\subsection{curl}{

\if{html}{\out{<div class="sourceCode">}}\preformatted{curl -X GET 'https://api.binance.com/sapi/v1/margin/myTrades?symbol=BTCUSDT&limit=500&timestamp=...&signature=...' \\
  -H 'X-MBX-APIKEY: your-api-key'
}\if{html}{\out{</div>}}
}

\subsection{JSON Response}{

\if{html}{\out{<div class="sourceCode json">}}\preformatted{[
  \{
    "commission": "0.00000500",
    "commissionAsset": "BTC",
    "id": 6,
    "isBestMatch": true,
    "isBuyer": true,
    "isMaker": false,
    "orderId": 28,
    "price": "52341.12000000",
    "qty": "0.00010000",
    "symbol": "BTCUSDT",
    "isIsolated": false,
    "time": 1507725176595
  \}
]
}\if{html}{\out{</div>}}
}
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{BinanceMargin$get_trades(
  symbol,
  order_id = NULL,
  start_time = NULL,
  end_time = NULL,
  from_id = NULL,
  limit = NULL,
  is_isolated = NULL,
  recv_window = NULL
)}\if{html}{\out{</div>}}
}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{symbol}}{(scalar<character>) trading pair (e.g., \code{"BTCUSDT"}).}

\item{\code{order_id}}{(scalar<count>?) filter by order ID.}

\item{\code{start_time}}{(scalar<count>?) start timestamp in milliseconds.}

\item{\code{end_time}}{(scalar<count>?) end timestamp in milliseconds.}

\item{\code{from_id}}{(scalar<count>?) trade ID to fetch from.}

\item{\code{limit}}{(scalar<count>?) max results (default 500, max 1000).}

\item{\code{is_isolated}}{(scalar<character>?) \code{"TRUE"} or \code{"FALSE"} for isolated margin.}

\item{\code{recv_window}}{(scalar<count>?) max 60000.}
}
\if{html}{\out{</div>}}
}
\subsection{Returns}{
(data.table | promise<data.table>) one row per trade
(empty when there are none):
\itemize{
