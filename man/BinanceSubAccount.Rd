Verified: 2026-05-22
}

\subsection{curl}{

\if{html}{\out{<div class="sourceCode">}}\preformatted{curl -X GET 'https://api.binance.com/sapi/v2/sub-account/futures/account?email=sub\%40virtual.com&futuresType=1&timestamp=...&signature=...' \\
  -H 'X-MBX-APIKEY: your-api-key'
}\if{html}{\out{</div>}}
}

