\subsection{Method \code{get_status()}}{
Get Sub-Account Status

Retrieves the status of sub-accounts, including enablement flags and
activity state.
\subsection{API Endpoint}{

\verb{GET https://api.binance.com/sapi/v1/sub-account/status}
}

\subsection{Official Documentation}{

\href{https://developers.binance.com/docs/sub_account/account-management/Get-Sub-accounts-Status-on-Margin-Or-Futures}{Binance Sub-Account Status}
Verified: 2026-05-22
}

\subsection{curl}{

\if{html}{\out{<div class="sourceCode">}}\preformatted{curl -X GET 'https://api.binance.com/sapi/v1/sub-account/status?timestamp=...&signature=...' \\
  -H 'X-MBX-APIKEY: your-api-key'
}\if{html}{\out{</div>}}
}

\subsection{JSON Response}{

\if{html}{\out{<div class="sourceCode json">}}\preformatted{[
  \{
    "email": "testsub01@virtual.com",
    "isSubUserEnabled": true,
    "isUserActive": true,
    "insertTime": 1661493146000,
    "isMarginEnabled": false,
    "isFutureEnabled": false,
    "mobile": 0
  \}
]
}\if{html}{\out{</div>}}
}
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{BinanceSubAccount$get_status(email = NULL, recvWindow = NULL)}\if{html}{\out{</div>}}
}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{email}}{(scalar<character>?) filter by sub-account email.}

\item{\code{recvWindow}}{(scalar<count>?) max 60000.}
}
\if{html}{\out{</div>}}
}
\subsection{Returns}{
(data.table | promise<data.table>) one row per sub-account
(empty when there are none):
\itemize{
\item email (character) Sub-account email.
\item is_sub_user_enabled (logical) Whether the sub-user is enabled.
\item is_user_active (logical) Whether the user is active.
\item insert_time (POSIXct) Time the sub-account was inserted.
\item is_margin_enabled (logical) Whether margin trading is enabled.
\item is_future_enabled (logical) Whether futures trading is enabled.
\item mobile (integer) Mobile verification status.
}
}
