  "quoteVolume": "19187654321.56",
  "openTime": 1709942400000,
  "closeTime": 1710028799999,
  "firstId": 4123456789,
  "lastId": 4123987654,
  "count": 530865
\}
}\if{html}{\out{</div>}}
}
