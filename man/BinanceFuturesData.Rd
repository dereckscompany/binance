\subsection{Method \code{get_mark_price_klines()}}{
Get Mark Price Klines

Retrieves historical mark price kline/candlestick data for a symbol.
\subsection{API Endpoint}{

\verb{GET https://fapi.binance.com/fapi/v1/markPriceKlines}
}

\subsection{Official Documentation}{

\href{https://developers.binance.com/docs/derivatives/usds-margined-futures/market-data/rest-api/Mark-Price-Kline-Candlestick-Data}{Binance Futures Mark Price Kline/Candlestick Data}
Verified: 2026-05-22
}

\subsection{curl}{

\if{html}{\out{<div class="sourceCode">}}\preformatted{curl -X GET 'https://fapi.binance.com/fapi/v1/markPriceKlines?symbol=BTCUSDT&interval=1h&limit=100'
}\if{html}{\out{</div>}}
}

\subsection{JSON Response}{

\if{html}{\out{<div class="sourceCode json">}}\preformatted{[
  [
    1710028800000,
    "67525.10",
    "67848.75",
    "67312.40",
    "67635.20",
    "0",
    1710032399999,
    "0",
    0,
    "0",
    "0",
    "0"
  ]
]
}\if{html}{\out{</div>}}
}
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{BinanceFuturesData$get_mark_price_klines(
  symbol,
  interval = "1h",
  startTime = NULL,
  endTime = NULL,
  limit = NULL
)}\if{html}{\out{</div>}}
}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{symbol}}{(scalar<character>) trading pair (e.g., \code{"BTCUSDT"}).}

\item{\code{interval}}{(scalar<character>) candle interval. Valid values:
\code{"1s"}, \code{"1m"}, \code{"3m"}, \code{"5m"}, \code{"15m"}, \code{"30m"},
\code{"1h"}, \code{"2h"}, \code{"4h"}, \code{"6h"}, \code{"8h"}, \code{"12h"},
\code{"1d"}, \code{"3d"}, \code{"1w"}, \code{"1M"}.}

\item{\code{startTime}}{(scalar<POSIXct> | scalar<numeric>?) start time (ms or POSIXct).}

\item{\code{endTime}}{(scalar<POSIXct> | scalar<numeric>?) end time (ms or POSIXct).}

\item{\code{limit}}{(scalar<count>?) max results (default 500, max 1500).}
}
\if{html}{\out{</div>}}
}
\subsection{Returns}{
(Ohlcv | promise<Ohlcv>) one row per candle.
}
\subsection{Examples}{
\if{html}{\out{<div class="r example copy">}}
\preformatted{\dontrun{
futures <- BinanceFuturesData$new()
klines <- futures$get_mark_price_klines("BTCUSDT", "1h", limit = 24)
print(klines)
}
}
\if{html}{\out{</div>}}

}

