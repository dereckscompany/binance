\item \strong{Technical Analysis}: Feed OHLCV data into indicator calculations (RSI, MACD, etc.).
\item \strong{Backtesting}: Download historical candles for strategy evaluation.
\item \strong{Volume Analysis}: Use \code{volume} and \code{quote_volume} for liquidity assessment.
}
}
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{BinanceMarketData$get_klines(
  symbol,
  interval = "1h",
  startTime = NULL,
  endTime = NULL,
  limit = NULL
)}\if{html}{\out{</div>}}
}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{symbol}}{Character; trading pair (e.g., \code{"BTCUSDT"}).}

\item{\code{interval}}{Character; candle interval. Valid values:
\code{"1s"}, \code{"1m"}, \code{"3m"}, \code{"5m"}, \code{"15m"}, \code{"30m"},
\code{"1h"}, \code{"2h"}, \code{"4h"}, \code{"6h"}, \code{"8h"}, \code{"12h"},
\code{"1d"}, \code{"3d"}, \code{"1w"}, \code{"1M"}.}

\item{\code{startTime}}{POSIXct or numeric or NULL; start time (ms or POSIXct).}

\item{\code{endTime}}{POSIXct or numeric or NULL; end time (ms or POSIXct).}

\item{\code{limit}}{Integer or NULL; max results (default 500, max 1000).}
}
\if{html}{\out{</div>}}
}
\subsection{Returns}{
\code{data.table} with columns: \code{datetime}, \code{open}, \code{high}, \code{low}, \code{close},
\code{volume}, \code{quote_volume}, \code{trades}, \code{taker_buy_base_volume}, \code{taker_buy_quote_volume}.
}
